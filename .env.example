# Copy to .env and fill in. Both keys come from the same GCP project.

# Google Cloud Text-to-Speech API key
GOOGLE_TTS_KEY=your_google_tts_api_key_here

# YouTube Data API v3 key
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── Optional ────────────────────────────────────────────────────────────────

# Writable directory for the lyrics/TTS caches (default: ./data)
# DATA_DIR=./data

# Timeout in seconds for calls to Google APIs (default: 10)
# HTTP_TIMEOUT=10

# Port for the Docker image (Render and similar hosts set this automatically)
# PORT=8000
